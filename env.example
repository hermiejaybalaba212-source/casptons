# Copy this file to .env.local for local development.
# In Vercel, add these values under Project Settings > Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-main-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-main-project-anon-key

NEXT_PUBLIC_REGISTRAR_SUPABASE_URL=https://your-registrar-project.supabase.co
NEXT_PUBLIC_REGISTRAR_SUPABASE_ANON_KEY=your-registrar-project-anon-key

# Server-side only. Never expose this as a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=your-main-project-service-role-key

# ML_URL is injected automatically by vercel.json on Vercel.
# PYTHON_BIN is optional and normally only needed for local development.
